/dts-v1/;
/plugin/;

/ {
    compatible = "brcm,bcm2711";

    fragment@0 {
        target-path = "/soc";
        __overlay__ {

            my_uart: my_uart@7e201000 {
                compatible = "techdhaba,my-uart";
                reg = <0x0 0xFE201000 0x0 0x90>;
                status = "okay";
            };
        };
    };
};
